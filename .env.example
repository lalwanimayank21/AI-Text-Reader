# ElevenLabs API Configuration
# Get your API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default Voice ID (Optional - defaults to Adam 'pNInz6obpgDQGcFmaJgB')
# Popular pre-made voices:
# - Adam:   pNInz6obpgDQGcFmaJgB (Recommended - works across all tiers)
# - George: JBFqnCBsd6RMkjVDRZzb
# - Sarah:  EXAVITQu4vr4xnSDxMaL
# - Alice:  Xb7hH8MSUJpSbSDYk0k2
# - Rachel: 21m00Tcm4TlvDq8ikWAM (Requires Creator plan)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Model ID (Options: eleven_multilingual_v2, eleven_turbo_v2_5, eleven_monolingual_v1)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Maximum characters allowed per generation request (Optional - default: 2500)
MAX_TEXT_LENGTH=2500

# Server Port
PORT=3000
